<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title || 'Yarn & Bloom' %></title>
    <meta name="description" content="Yarn & Bloom — handmade crochet bags, flowers, toys and personalised gifts." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/responsive.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <script defer src="/js/main.js"></script>
  </head>
  <body>
    <div class="topbar">
      <div class="container small-row">
        <span>Handmade with love in Nairobi</span>
        <span><%= settings && settings.business_hours ? settings.business_hours : 'Mon–Sat • 9am–5pm' %></span>
      </div>
    </div>

    <header class="site-header">
      <div class="container nav-wrap">
        <a href="/" class="brand" aria-label="Yarn & Bloom home">
          <span class="brand-mark">Y&B</span>
          <span class="brand-text">
            <strong>Yarn & Bloom</strong>
            <small>Made with love</small>
          </span>
        </a>

        <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" data-nav-toggle type="button">☰</button>

        <nav class="main-nav" aria-label="Main navigation" data-nav>
          <a href="/" class="<%= activeNav === 'home' ? 'active' : '' %>">Home</a>
          <a href="/shop" class="<%= activeNav === 'shop' ? 'active' : '' %>">Shop</a>
          <a href="/custom-order" class="<%= activeNav === 'custom-order' ? 'active' : '' %>">Custom Orders</a>
          <a href="/our-story" class="<%= activeNav === 'our-story' ? 'active' : '' %>">About</a>
          <a href="/bag" class="shopping-bag-link <%= activeNav === 'bag' ? 'active' : '' %>" aria-label="Shopping bag">
            Bag
            <svg class="bag-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none">
              <path d="M5 8h14l1 13H4L5 8Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
              <path d="M9 9V6a3 3 0 0 1 6 0v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
            </svg>
            <span class="bag-count" data-bag-count>0</span>
          </a>
        </nav>
      </div>
    </header>

    <main>
