<section class="admin-section">
  <h1><%= isEdit ? 'Edit product' : 'Add new product' %></h1>
  <div class="page-card">
    <form action="<%= isEdit ? '/admin/products/' + product.id + '/edit' : '/admin/products/new' %>" method="POST" enctype="multipart/form-data" class="form-grid">
      <div class="form-group">
        <label for="name">Product name</label>
        <input id="name" name="name" value="<%= product && product.name ? product.name : '' %>" required />
      </div>
      <div class="form-group">
        <label for="category_id">Category</label>
        <select id="category_id" name="category_id">
          <% (categories || []).forEach((category) => { %>
            <option value="<%= category.id %>" <%= product && product.category_id == category.id ? 'selected' : '' %>><%= category.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label for="price">Price (KSh)</label>
        <input id="price" name="price" type="number" step="0.01" min="0" value="<%= product && product.price ? product.price : '' %>" required />
      </div>
      <div class="form-group">
        <label for="compare_at_price">Compare-at price</label>
        <input id="compare_at_price" name="compare_at_price" type="number" step="0.01" min="0" value="<%= product && product.compare_at_price ? product.compare_at_price : '' %>" />
      </div>
      <div class="form-group">
        <label for="stock_status">Stock status</label>
        <select id="stock_status" name="stock_status">
          <option value="in_stock" <%= product && product.stock_status === 'in_stock' ? 'selected' : '' %>>In stock</option>
          <option value="made_to_order" <%= product && product.stock_status === 'made_to_order' ? 'selected' : '' %>>Made to order</option>
          <option value="out_of_stock" <%= product && product.stock_status === 'out_of_stock' ? 'selected' : '' %>>Out of stock</option>
        </select>
      </div>
      <div class="form-group">
        <label for="estimated_production_days">Production days</label>
        <input id="estimated_production_days" name="estimated_production_days" type="number" min="1" value="<%= product && product.estimated_production_days ? product.estimated_production_days : 3 %>" />
      </div>
      <div class="form-group full">
        <label for="short_description">Short description</label>
        <textarea id="short_description" name="short_description" required><%= product && product.short_description ? product.short_description : '' %></textarea>
      </div>
      <div class="form-group full">
        <label for="detailed_description">Detailed description</label>
        <textarea id="detailed_description" name="detailed_description" required><%= product && product.detailed_description ? product.detailed_description : '' %></textarea>
      </div>
      <div class="form-group full">
        <label for="materials">Materials</label>
        <textarea id="materials" name="materials"><%= product && product.materials ? product.materials : '' %></textarea>
      </div>
      <div class="form-group">
        <label for="dimensions">Dimensions</label>
        <input id="dimensions" name="dimensions" value="<%= product && product.dimensions ? product.dimensions : '' %>" />
      </div>
      <div class="form-group">
        <label for="available_colors">Available colours</label>
        <input id="available_colors" name="available_colors" value="<%= product && product.available_colors ? product.available_colors : '' %>" />
      </div>
      <div class="form-group">
        <label for="occasions">Occasions</label>
        <input id="occasions" name="occasions" value="<%= product && product.occasions ? product.occasions : '' %>" />
      </div>
      <div class="form-group">
        <label for="care_instructions">Care instructions</label>
        <input id="care_instructions" name="care_instructions" value="<%= product && product.care_instructions ? product.care_instructions : '' %>" />
      </div>
      <div class="form-group full">
        <label for="primary_image">Primary image <%= isEdit ? '(leave empty to keep the current image)' : '' %></label>
        <input id="primary_image" name="primary_image" type="file" accept="image/*" />
      </div>
      <div class="form-group full">
        <label for="additional_images">Additional product images (up to 5)</label>
        <input id="additional_images" name="additional_images" type="file" accept="image/*" multiple />
      </div>
      <div class="form-group full">
        <label><input type="checkbox" name="is_featured" <%= product && product.is_featured ? 'checked' : '' %> /> Featured</label>
        <label><input type="checkbox" name="is_customizable" <%= product && product.is_customizable ? 'checked' : '' %> /> Customizable</label>
        <label><input type="checkbox" name="is_active" <%= product && product.is_active !== false ? 'checked' : '' %> /> Active</label>
      </div>
      <div class="form-group full">
        <button class="btn btn-primary" type="submit"><%= isEdit ? 'Update product' : 'Create product' %></button>
      </div>
    </form>
  </div>
</section>
