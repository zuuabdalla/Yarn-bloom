<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title || 'Admin' %></title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <script defer src="/js/main.js"></script>
  </head>
  <body class="admin-body">
    <div class="admin-shell">
      <aside class="admin-sidebar">
        <div class="brand">
          <span class="brand-mark">Y&B</span>
          <span class="brand-text">
            <strong>Yarn & Bloom</strong>
            <small>Admin</small>
          </span>
        </div>
        <nav class="admin-nav">
          <a href="/admin/dashboard" class="<%= activeTab === 'dashboard' ? 'active' : '' %>">Dashboard</a>
          <a href="/admin/products" class="<%= activeTab === 'products' ? 'active' : '' %>">Products</a>
          <a href="/admin/enquiries" class="<%= activeTab === 'enquiries' ? 'active' : '' %>">Enquiries</a>
          <form action="/admin/logout" method="POST" style="margin-top:auto;">
            <button class="btn btn-primary" type="submit">Logout</button>
          </form>
        </nav>
      </aside>
      <main class="admin-main">
        <%- body %>
      </main>
    </div>
  </body>
</html>
