<section class="page-shell">
  <div class="container">
    <div class="section-header">
      <div>
        <div class="eyebrow">Gift builder</div>
        <h1>Build a gift box with a little AI help.</h1>
      </div>
    </div>

    <details class="ai-builder-panel page-card">
      <summary><span class="eyebrow">AI gift builder</span><strong>Need a little inspiration? Get an AI suggestion.</strong></summary>
      <div class="ai-builder-content">
      <h2 id="ai-builder-heading">Start with a thoughtful suggestion.</h2>
      <p>Share who the gift is for and your budget. We’ll suggest real handmade items and preselect them below for you to review.</p>
      <form action="/gift-box/ai-suggest" method="POST" class="form-grid ai-builder-form">
        <div class="form-group">
          <label for="ai_recipient">Who are you shopping for?</label>
          <input id="ai_recipient" name="recipient" value="<%= answers && answers.recipient ? answers.recipient : '' %>" placeholder="Mum, a friend, a new baby..." />
        </div>
        <div class="form-group">
          <label for="ai_occasion">Occasion</label>
          <input id="ai_occasion" name="occasion" value="<%= answers && answers.occasion ? answers.occasion : '' %>" placeholder="Birthday, thank you, anniversary..." />
        </div>
        <div class="form-group">
          <label for="ai_max_budget">Budget (KSh)</label>
          <input id="ai_max_budget" name="max_budget" type="number" min="800" max="1000000" step="100" value="<%= answers && answers.budget ? answers.budget : '' %>" placeholder="5000" />
        </div>
        <div class="form-group">
          <label for="ai_color_theme">Colour theme</label>
          <input id="ai_color_theme" name="color_theme" value="<%= answers && answers.colors ? answers.colors : 'Sage Meadow (Sage & Cream)' %>" placeholder="Sage, blush, warm neutrals..." />
        </div>
        <div class="form-group full">
          <label for="gift_style">Gift style or interests</label>
          <input id="gift_style" name="gift_style" value="<%= answers && answers.preference ? answers.preference : '' %>" placeholder="Cosy, playful, elegant, loves flowers..." />
        </div>
        <div class="form-group full">
          <button class="btn btn-secondary" type="submit">Suggest a gift box</button>
        </div>
      </form>
      <p class="ai-privacy-note">Share a relationship or recipient type, not a name or contact details. Only gift preferences and catalog details are used for AI suggestions.</p>

      <% if (suggestion) { %>
        <div class="ai-result-note" role="status">
          <strong><%= suggestion.source === 'ai' ? 'AI gift idea' : suggestion.source === 'fallback' ? 'Catalog suggestions' : 'Preference-matched suggestions' %></strong>
          <p><%= suggestion.summary %></p>
        </div>
        <% if (suggestion.recommendations.length) { %>
          <ul class="ai-suggestion-list">
            <% suggestion.recommendations.forEach((product) => { %>
              <li>
                <strong><%= product.name %></strong>
                <span><%= formatKSh(product.price) %></span>
                <% if (product.matchReasons && product.matchReasons.length) { %>
                  <p><%= product.matchReasons[0] %></p>
                <% } %>
              </li>
            <% }) %>
          </ul>
        <% } %>
      <% } %>
      </div>
    </details>

    <div class="page-card">
      <form action="/gift-box" method="POST" class="gift-box-form" data-gift-box-form>
        <div class="gift-box-selection">
          <div class="section-header"><div><div class="eyebrow">Step 1</div><h2>Choose your handmade gifts</h2></div></div>
          <div class="gift-item-groups">
            <% const giftGroups = [['Bags', bagItems], ['Flowers', flowerItems], ['Toys', toyItems], ['More favourites', otherItems]]; %>
            <% giftGroups.forEach(([groupName, groupItems]) => { if (groupItems && groupItems.length) { %>
              <fieldset class="gift-item-group">
                <legend><%= groupName %></legend>
                <div class="gift-item-list">
                  <% groupItems.forEach((item) => { %>
                    <label class="gift-item-choice">
                      <input type="checkbox" name="selected_product_ids" value="<%= item.id %>" <%= selectedProductIds && selectedProductIds.includes(String(item.id)) ? 'checked' : '' %> data-gift-price="<%= item.price %>" />
                      <img src="<%= item.primary_image || item.image_url || '/images/moodboard/brand-panel.png' %>" alt="" loading="lazy" />
                      <span><strong><%= item.name %></strong><small><%= formatKSh(item.price) %></small></span>
                    </label>
                  <% }) %>
                </div>
              </fieldset>
            <% } }) %>
          </div>
        </div>
        <aside class="gift-box-options">
          <div class="eyebrow">Step 2</div>
          <h2>Make it personal</h2>
          <div class="form-group">
            <label for="customer_name">Your name</label>
            <input id="customer_name" name="customer_name" required />
          </div>
          <div class="form-group">
            <label for="whatsapp_number">WhatsApp number</label>
            <input id="whatsapp_number" name="whatsapp_number" placeholder="e.g. +254712345678" required />
          </div>
          <div class="form-group">
            <label for="recipient_name">Recipient name (optional)</label>
            <input id="recipient_name" name="recipient_name" />
          </div>
          <div class="form-group">
            <label for="occasion">Occasion</label>
            <input id="occasion" name="occasion" value="<%= answers && answers.occasion ? answers.occasion : '' %>" placeholder="Birthday, thank you..." />
          </div>
          <div class="form-group">
            <label for="color_theme">Colour theme</label>
            <input id="color_theme" name="color_theme" value="<%= answers && answers.colors ? answers.colors : 'Sage Meadow (Sage & Cream)' %>" />
          </div>
          <div class="form-group">
            <label for="max_budget">Budget (KSh)</label>
            <input id="max_budget" name="max_budget" type="number" min="800" max="1000000" step="100" value="<%= answers && answers.budget ? answers.budget : '' %>" />
          </div>
          <div class="form-group">
            <label for="gift_message">Gift message</label>
            <textarea id="gift_message" name="gift_message" placeholder="Write a short message for the recipient."></textarea>
          </div>
          <div class="gift-estimate"><span>Estimated total</span><strong data-gift-box-total>KSh 0</strong><small>Final total is confirmed after we review your selection.</small></div>
          <button class="btn btn-primary" type="submit">Create my gift box</button>
        </aside>
      </form>
    </div>
  </div>
</section>
