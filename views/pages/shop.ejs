<section class="page-shell shop-page">
  <div class="container">
    <div class="section-header shop-heading">
      <div class="shop-breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Shop collection</span></div>
      <div class="shop-heading-copy">
        <div>
          <div class="eyebrow">Slow-made textiles</div>
          <h1>Explore Our Handmade Collection</h1>
        </div>
        <p>Lovingly hand-stitched pieces made with natural fibres and attention to every loop. Thoughtful keepsakes for everyday living and meaningful gifting.</p>
      </div>
    </div>

    <div class="page-card">
      <form method="GET" action="/shop" class="form-grid shop-filter-form">
        <div class="form-group">
          <label for="category">Category</label>
          <select id="category" name="category">
            <option value="all" <%= selectedCategory === 'all' ? 'selected' : '' %>>All products</option>
            <% (categories || []).forEach((category) => { %>
              <option value="<%= category.slug %>" <%= selectedCategory === category.slug ? 'selected' : '' %>><%= category.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="search">Search</label>
          <input id="search" name="search" value="<%= searchQuery || '' %>" placeholder="Search crochet bags, bouquets, baby gifts..." />
        </div>
        <div class="form-group">
          <label for="sort">Sort by</label>
          <select id="sort" name="sort">
            <option value="newest" <%= sortBy === 'newest' ? 'selected' : '' %>>Newest</option>
            <option value="featured" <%= sortBy === 'featured' ? 'selected' : '' %>>Featured</option>
            <option value="price-asc" <%= sortBy === 'price-asc' ? 'selected' : '' %>>Price: Low to high</option>
            <option value="price-desc" <%= sortBy === 'price-desc' ? 'selected' : '' %>>Price: High to low</option>
            <option value="name-asc" <%= sortBy === 'name-asc' ? 'selected' : '' %>>Name</option>
          </select>
        </div>
        <div class="form-group">
          <label for="availability">Availability</label>
          <select id="availability" name="availability">
            <option value="all" <%= availability === 'all' ? 'selected' : '' %>>All availability</option>
            <option value="available" <%= availability === 'available' ? 'selected' : '' %>>Available to order</option>
            <option value="unavailable" <%= availability === 'unavailable' ? 'selected' : '' %>>Out of stock</option>
          </select>
        </div>
        <div class="form-group">
          <button class="btn btn-primary" type="submit">Filter</button>
        </div>
      </form>
    </div>

    <div class="shop-favorites-tools" id="saved-products">
      <p class="favorites-status" data-favorites-status role="status" aria-live="polite"></p>
      <button class="btn btn-secondary" type="button" data-favorites-filter aria-pressed="false">
        <span data-favorites-filter-label>Show saved pieces</span>
        <span class="saved-products-count" data-favorites-count>0</span>
      </button>
    </div>

    <nav class="shop-category-links" aria-label="Browse product categories">
      <a class="shop-category-link <%= selectedCategory === 'all' ? 'active' : '' %>" href="/shop">All pieces</a>
      <% (categories || []).forEach((category) => { %>
        <a class="shop-category-link <%= selectedCategory === category.slug ? 'active' : '' %>" href="/shop?category=<%= encodeURIComponent(category.slug) %>"><%= category.name %></a>
      <% }) %>
    </nav>

    <div class="section" style="padding-top:2rem;">
      <% if (products && products.length) { %>
        <div class="shop-results-summary" data-shop-results-summary data-total-products="<%= totalProducts %>">
          <p data-shop-results-count>
            Showing <strong><%= products.length %></strong> of <strong><%= totalProducts %></strong> pieces
            <% if (activeCategory) { %> in <strong><%= activeCategory.name %></strong><% } %>
            <% if (searchQuery) { %> for “<strong><%= searchQuery %></strong>”<% } %>
          </p>
          <% if (selectedCategory !== 'all' || searchQuery || availability !== 'all') { %>
            <a class="shop-clear-link" href="/shop">Clear filters</a>
          <% } %>
        </div>
        <div class="product-grid" data-shop-product-grid>
          <% products.forEach((product) => { %>
            <%- include('../partials/product-card', { product, formatKSh, WhatsAppService }) %>
          <% }) %>
        </div>
        <div class="empty-state favorites-empty-state" data-favorites-empty hidden>
          <h3>No saved pieces on this page yet.</h3>
          <p>Save a favorite with the heart button, or browse all pieces to find something you love.</p>
          <a class="btn btn-primary" href="/shop">Browse the shop</a>
        </div>

        <% if (totalPages > 1) { %>
          <div class="small-row shop-pagination" data-shop-pagination style="margin-top:2rem; justify-content:center;">
            <% const currentPageNum = Number(currentPage || 1); %>
            <% if (currentPageNum > 1) { %>
              <a class="btn btn-secondary" href="/shop?category=<%= selectedCategory %>&search=<%= encodeURIComponent(searchQuery || '') %>&sort=<%= sortBy %>&availability=<%= availability %>&page=<%= currentPageNum - 1 %>">Previous</a>
            <% } %>
            <span>Page <%= currentPageNum %> of <%= totalPages %></span>
            <% if (currentPageNum < totalPages) { %>
              <a class="btn btn-secondary" href="/shop?category=<%= selectedCategory %>&search=<%= encodeURIComponent(searchQuery || '') %>&sort=<%= sortBy %>&availability=<%= availability %>&page=<%= currentPageNum + 1 %>">Next</a>
            <% } %>
          </div>
        <% } %>
      <% } else { %>
        <div class="empty-state">
          <% if (searchQuery || (selectedCategory && selectedCategory !== 'all')) { %>
            <h3>No products match your filters.</h3>
            <p>Try a different keyword or category, or browse all handmade pieces.</p>
          <% } else { %>
            <h3>Our shop is being refreshed.</h3>
            <p>There are no products listed just now. Please check back soon or <a href="/contact">contact us</a> for a handmade order.</p>
          <% } %>
          <div class="empty-state-actions">
            <a class="btn btn-primary" href="/shop">Clear filters</a>
            <a class="btn btn-secondary" href="/gift-finder">Try the AI gift finder</a>
          </div>
        </div>
      <% } %>
    </div>

    <section class="shop-custom-cta">
      <div>
        <span class="eyebrow">Tailor-made commissions</span>
        <h2>Need a custom colour combination or personalised size?</h2>
        <p>We’re happy to craft bespoke pieces. Share your idea and we’ll help you bring it to life.</p>
      </div>
      <a class="btn btn-secondary" href="/custom-order">Request a custom order <span aria-hidden="true">→</span></a>
    </section>
    <div class="shop-service-notes" aria-label="Yarn and Bloom service highlights">
      <div><span aria-hidden="true">✿</span><strong>Handmade in Nairobi</strong><small>Small-batch pieces, carefully made by hand.</small></div>
      <div><span aria-hidden="true">♡</span><strong>Personal touches</strong><small>Custom colors and gift notes are welcome.</small></div>
      <div><span aria-hidden="true">↗</span><strong>Order with care</strong><small>We’ll help with details and delivery arrangements.</small></div>
    </div>
  </div>
</section>
