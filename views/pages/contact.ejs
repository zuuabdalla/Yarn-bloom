<section class="page-shell">
  <div class="container">
    <div class="section-header contact-heading">
      <div>
        <div class="eyebrow">Contact</div>
        <h1>Get in Touch</h1>
        <p>We'd love to hear from you!</p>
      </div>
      <img src="/images/moodboard/crochet-flower-bouquets.png" alt="A soft crochet bouquet arranged in the studio" />
    </div>

    <div class="feature-layout">
      <div class="page-card">
        <h2>Send us a message</h2>
        <form action="/contact" method="POST" class="form-grid">
          <div class="form-group">
            <label for="name">Full name</label>
            <input id="name" name="name" value="<%= formData && formData.name ? formData.name : '' %>" required />
          </div>
          <div class="form-group">
            <label for="email">Email address</label>
            <input id="email" name="email" type="email" value="<%= formData && formData.email ? formData.email : '' %>" required />
          </div>
          <div class="form-group">
            <label for="phone">Phone number</label>
            <input id="phone" name="phone" value="<%= formData && formData.phone ? formData.phone : '' %>" />
          </div>
          <div class="form-group">
            <label for="subject">Subject</label>
            <input id="subject" name="subject" value="<%= formData && formData.subject ? formData.subject : '' %>" required />
          </div>
          <div class="form-group full">
            <label for="message">How can we help you?</label>
            <textarea id="message" name="message" required><%= formData && formData.message ? formData.message : '' %></textarea>
          </div>
          <div class="form-group full">
            <button class="btn btn-primary" type="submit">Send message</button>
          </div>
        </form>
      </div>
      <div>
        <div class="summary-box">
          <h2>Contact details</h2>
          <p><strong>WhatsApp</strong><br /><a href="<%= generalWhatsAppUrl %>" target="_blank" rel="noreferrer"><%= settings && settings.business_phone ? settings.business_phone : '+254141703242' %></a></p>
          <p><strong>Email</strong><br /><a href="mailto:<%= settings && settings.business_email ? settings.business_email : 'zuhuraabdalla495@gmail.com' %>"><%= settings && settings.business_email ? settings.business_email : 'zuhuraabdalla495@gmail.com' %></a></p>
          <p><strong>Location</strong><br /><%= settings && settings.business_location ? settings.business_location : 'Nairobi, Kenya' %></p>
          <p><strong>Business hours</strong><br /><%= settings && settings.business_hours ? settings.business_hours : 'Mon–Sat • 9am–5pm' %></p>
        </div>
        <div class="contact-faq">
          <h3>Frequently asked questions</h3>
          <details><summary>How long do custom orders take?</summary><p>Timing depends on the design. We'll confirm an estimate when we review your request.</p></details>
          <details><summary>Do you deliver?</summary><p><%= settings && settings.delivery_info ? settings.delivery_info : 'Delivery options and costs are confirmed when you place your order.' %></p></details>
          <details><summary>Can I request a different color?</summary><p>Yes! Tell us your preferred colors in your message or custom order brief.</p></details>
        </div>
      </div>
    </div>
  </div>
</section>
